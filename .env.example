# Copy to .env and fill in. Never commit .env (CLAUDE.md §6).
# Any variable can instead be read from a file by setting NAME_FILE=/run/secrets/name.

# Your site's domain name; Caddy gets a certificate for it automatically.
SITE_ADDRESS=stacks.example.edu
DJANGO_ALLOWED_HOSTS=stacks.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://stacks.example.edu
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0

POSTGRES_DB=stacks
POSTGRES_USER=stacks
POSTGRES_PASSWORD=

STACKS_SITE_NAME=Stacks
# Links in emails the worker sends (availability reminders). Defaults to https://SITE_ADDRESS.
# STACKS_SITE_URL=https://stacks.example.edu
STACKS_TIME_ZONE=America/Chicago

# Outgoing email (D14)
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
DEFAULT_FROM_EMAIL=stacks@example.edu

# Campus sign-in over OpenID Connect (D5, D118). Leave OIDC_CLIENT_ID empty to use only Stacks
# passwords. It signs in people who already have a Stacks account; it never creates one.
# docs/install.md has the Google Workspace steps.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Google: https://accounts.google.com. Others: the issuer URL, e.g. https://login.microsoftonline.com/<tenant>/v2.0
OIDC_SERVER_URL=https://accounts.google.com
# The button reads "Sign in with <name>"; left empty, "Sign in with your campus account".
# The ID is part of the redirect URI.
OIDC_PROVIDER_NAME=Google
OIDC_PROVIDER_ID=campus
# Email domains allowed to sign in, comma-separated. Required when OIDC_CLIENT_ID is set.
OIDC_ALLOWED_DOMAINS=example.edu
# Google Workspace only: 1 also requires the account to belong to the Workspace (the hd claim).
# Set 0 for Entra, Okta, Keycloak and other providers: they don't send hd, so 1 refuses everyone.
OIDC_REQUIRE_HD=1

# CPUs and memory for the solver worker (D35: 4 vCPU on the pilot VPS)
WORKER_CPUS=4
WORKER_MEMORY=2g
